-- Test 16: BM25 tokenizer returns empty array for NULL input
---------------------------------------------------------------------------
SELECT COALESCE(
    array_length(pgedge_vectorizer.bm25_tokenize(NULL), 1),
    0
) AS token_count;
 token_count 
-------------
