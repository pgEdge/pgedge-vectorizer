---------------------------------------------------------------------------
SELECT tablename
FROM pg_tables
WHERE tablename = 'hybrid_test_docs_content_chunks_idf_stats';
                 tablename                 
-------------------------------------------
 hybrid_test_docs_content_chunks_idf_stats
(1 row)

