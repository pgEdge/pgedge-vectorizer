---------------------------------------------------------------------------
SELECT proname
FROM pg_proc
WHERE proname = 'hybrid_search'
  AND pronamespace = (
      SELECT oid FROM pg_namespace
      WHERE nspname = 'pgedge_vectorizer'
  );
    proname    
---------------
 hybrid_search
(1 row)

---------------------------------------------------------------------------
-- Test 8: hybrid_search_simple function exists
---------------------------------------------------------------------------
SELECT proname
FROM pg_proc
WHERE proname = 'hybrid_search_simple'
  AND pronamespace = (
      SELECT oid FROM pg_namespace
      WHERE nspname = 'pgedge_vectorizer'
  );
       proname        
----------------------
